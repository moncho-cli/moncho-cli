# .env.bench — the credentials and the performance knobs for THIS bench.
#
# Gitignored, mode 600, sourced as shell exactly like .env.moncho: quoting, comments
# and `export` behave the way you expect. Values travel into the container as
# `-e NAME`, never `-e NAME=value`, so a key never appears in the host process list.
#
# Nothing here is committed. Nothing here is printed by `moncho-cli bench` — it records a key
# as `present: true|false` and never its value.

# --- provider (required) -----------------------------------------------------
# Any OpenAI-compatible endpoint. The host is recorded in every run's manifest; the
# full URL is not, because a query string can carry a token.
OPENAI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENAI_API_KEY="sk-or-v1-REPLACE-ME"
OPENAI_MODEL="deepseek/deepseek-v4.1-flash"

# Sampling temperature. A bench pins this deliberately: 0 removes a source of
# variance that would otherwise be recorded as a difference between configurations.
MODEL_TEMPERATURE="0"

# --- performance knobs -------------------------------------------------------
# These are the variables an experiment moves. Every one of them is recorded in
# config-snapshot.json with its source, so a change is attributable rather than
# remembered. Leave one commented out to measure the default; the record will say so.

# Working token budget. Unset, the provider's real total is used.
CONTEXT_MAX_LENGTH="128000"

# Share of the window replaced by one summary on compaction (0.7, 70 or 70%).
#COMPACTION_OLD_RATIO="0.7"

# Collapse a solved task item's section into a summary, keeping its raw chunks as a
# capture. Off by default: a cloud provider caches a verbatim prefix at a discount,
# while the collapse rewrites it, so this is worth testing rather than assuming.
#CHUNKPACTION_ENABLED="1"

# Model calls between two resets of the call pulse.
#PULSE_LIMIT="30"

# --- what the agent may run --------------------------------------------------
# The command palette. `run_bash` is not a sandbox and never was: the container is the
# capability boundary (docs/agent/command-sandbox). This widens the palette so the
# agent can run the tests it is being graded on — which is the difference between
# measuring an agent that can check its work and one that cannot.
RUN_BASH_ALLOWED="python3,python,pytest,pip,git,ls,cat,grep,find,head,tail,wc,echo,pwd,mkdir,diff,sed,awk,sort,uniq,xargs,env,which,true,false"
