# Benchfile — what this bench is. Committed, shareable, and free of credentials.
#
# The credentials and the provider live in .env.bench, which is gitignored and never
# shipped. This split is the point: two benches can run two providers, or two models,
# side by side without either file knowing about the other.
#
# Everything here is read by `moncho-cli bench`. A knob you leave out takes the default shown,
# and the record keeps "left alone" distinguishable from "set to the default".

# --- what this is ------------------------------------------------------------
BENCH_KIND="swe"
BENCH_NAME="swe-lite"

# --- what it measures --------------------------------------------------------
# The agent payload to run. A tag makes the run reproducible; `main` is the moving
# target and will make two runs of the same bench incomparable over time, which
# `compare` will notice and refuse.
AGENT_REF="main"
# The intent mode a rollout opens in: chat (read-only), design (authors task.md),
# work (unrestricted). A SWE-bench instance needs `work`.
AGENT_MODE="work"

# Cycles per instance. 1 is the honest baseline — it is what a single-turn harness
# does, and it keeps the numbers comparable with published ones. Raise it only to
# answer "do more turns help", never as a default.
TURNS="1"
# The nudge used for cycles 2..N. Empty uses the kind's built-in one, which restates
# the failing tests and asks for a fix rather than a fresh start.
TURNS_FOLLOWUP=""

# Hard stop per instance, in seconds. The rollout is killed at this point whatever it
# is doing; a run that dies here is recorded with `timeout` as its reason.
AGENT_TIMEOUT="1800"

# Unproductive cycles before the run is called stalled. "Unproductive" means neither
# the workspace diff nor the checklist moved — see bench/README.md.
STALL_CYCLES="3"

# The command palette the agent may run. Empty takes the agent's own default, which has
# no interpreter in it — and an agent that cannot run the tests cannot check its work,
# which is most of the difference between a useful number and a floor. Set in
# .env.bench rather than here, because it is a property of the *run*, not the bench.
#RUN_BASH_ALLOWED=""

# --- the subset --------------------------------------------------------------
# lite (300) | verified (500) | dev (23, the smoke set). `dev` is the one to run
# first: it is small, it is meant for developing the harness, and it is cheap.
SUBSET="lite"
# How the sample is drawn: `repo` stratifies by repository so no single project
# dominates; `first` takes them in dataset order.
STRATIFY="repo"
# How many instances. The full 300 is a real bill; 40 is enough for a first number
# with an interval worth quoting.
SAMPLE="40"

# --- grading and repeats -----------------------------------------------------
# Attempts per instance. With MODEL_TEMPERATURE=0 a repeat is near-deterministic, so
# 1 is usually right and the interval is over instances rather than repeats.
RUNS="1"
GRADE_WORKERS="8"

# --- runtime ------------------------------------------------------------------
# The pinned Node the agent runs on, mounted into the instance image. A glibc build,
# because the SWE-bench images are Debian-derived. `moncho-cli bench build` fetches it.
NODE_VERSION="22.14.0"
