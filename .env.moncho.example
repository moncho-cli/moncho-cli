# Moncho configuration for this project — copy to .env.moncho and fill in.
#
# moncho-cli reads THIS file and nothing else: a generic .env is deliberately ignored,
# so a project's own credentials never become the agent's provider. Pass another file
# explicitly with `moncho-cli --env <path> run`.
#
# The file is sourced as shell, so quoting, comments and `export` all behave the way
# you expect. It is never mounted into the container: the values travel as -e flags,
# so a key never appears in the host process list either.

# --- Provider -----------------------------------------------------------------
# Any OpenAI-compatible endpoint, or Ollama.
OPENAI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENAI_API_KEY="sk-or-v1-REPLACE-ME"
OPENAI_MODEL="deepseek/deepseek-v4.1-flash"
# Sampling temperature, in the conventional 0–2 range. Unset means the key is left
# out of the request and the provider's own default applies; an out-of-range or
# unparseable value is treated as unset rather than sent.
#MODEL_TEMPERATURE=0.3

# The `User-Agent` sent with every provider call and every web_fetch. Unset sends no
# header on a provider call and presents `moncho-cli` to a fetched host. Set it to name
# the program to the provider and to every host it fetches from.
#MONCHO_USER_AGENT="my-agent/1.0"

# Local Ollama instead (no API key needed). The container reaches the host through
# the gateway the runner adds, which is why the host name is not localhost:
#OPENAI_BASE_URL="http://host.containers.internal:11434/api/chat"
#OPENAI_API_KEY=""
#OPENAI_MODEL="qwen3.6:35b-a3b-q4_K_M"

# --- Context window -----------------------------------------------------------
# Working token budget. When unset, the real total the provider reports is used,
# falling back to 128000; the override still wins, and both are shown in the UI.
CONTEXT_MAX_LENGTH=256000
# Share of the window replaced by one summary chunk when it is compacted. Accepts
# 0.7, 70 or 70%; the kept share is derived as 1 minus this. Anything out of range
# falls back to 0.7.
COMPACTION_OLD_RATIO=0.7

# --- Project language ----------------------------------------------------------
# Optional language for project artifacts (tasks, docs and code comments); conversation
# can still follow the user's language. Project rules and conventions take precedence.
#PROJECT_LANGUAGE="English"

# --- File size budget ----------------------------------------------------------
# How many lines a file may hold before it must be split along its responsibilities.
# The number is rendered into the agent prompt, so the model and the maintainer are
# told the same budget. Default 600.
FILE_LINE_LIMIT=600

# --- Model-call pulse ---------------------------------------------------------
# Hard limit of agent model calls between two resets (default 30). The count is kept
# internally and raised as one notice when it is crossed; completing a task.md item
# or running a compaction resets it.
PULSE_LIMIT=30

# --- Operational log ----------------------------------------------------------
# A local, self-rotating log of what the harness *did* — a retried provider attempt,
# a tool that threw, a session that could not be saved. The file lives inside the
# workspace, so with the default state volume it lands in that volume.
LOG_LEVEL="info"
LOG_FILE="agent/logs/moncho.log"
LOG_MAX_BYTES=524288
LOG_MAX_FILES=5

# --- Clipboard copies -------------------------------------------------------
# What each saved selection leaves behind: `single` (the default) keeps only the
# last copy, `all` keeps a timestamped history. Anything else falls back to single.
CLIPBOARD_FILE_KEEP="single"

# --- Container clock ----------------------------------------------------------
# Passed through so the container's clock matches this host's.
TZ="Europe/Amsterdam"
