# Moncho configuration — copy to .env and fill in.
#
# Only these five variables are read by the app, and start.sh forwards them into
# the container when they are set. See README.md#configuration.

# --- Provider -----------------------------------------------------------------
# Any OpenAI-compatible endpoint, or Ollama.
OPENAI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENAI_API_KEY="sk-or-v1-REPLACE-ME"
OPENAI_MODEL="deepseek/deepseek-v4.1-flash"

# Local Ollama instead (no API key needed):
#OPENAI_BASE_URL="http://host.containers.internal:11434/api/chat"
#OPENAI_API_KEY=""
#OPENAI_MODEL="qwen3.6:35b-a3b-q4_K_M"

# --- Context window -----------------------------------------------------------
# Working token budget. When unset, the real total the provider reports is used,
# falling back to 128000; the override still wins, and both are shown in the UI.
CONTEXT_MAX_LENGTH=256000

# --- Model-call pulse ---------------------------------------------------------
# Hard limit of agent model calls between two resets (default 30). Every request
# carries a "[pulse] model call N of PULSE_LIMIT" line, and prompt.md instructs the
# model to honour it; completing a task.md item or running a compaction resets it.
# Anything that is not a positive integer falls back to the default.
PULSE_LIMIT=30
