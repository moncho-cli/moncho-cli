#!/usr/bin/env bash
#
# moncho — run a command inside the maintainer's container.
#
#   ./start.sh start      # the container runs detached, named "moncho"
#   moncho npm test       # the suite, inside that container
#   moncho sh             # a shell, if you want one
#
# This is the *maintainer* loop only: it talks to the container ./start.sh builds
# from ./Dockerfile. A user's project has its own container per directory, driven by
# `moncho-cli` — this helper knows nothing about it and is not installed by
# scripts/install.sh.
#
# The dev image ships Node 22 and the dev dependencies, so the suite runs in there
# without Node on the host. See CONTRIBUTING.md and REQUIREMENTS.md.

set -euo pipefail

CONTAINER_NAME="${MONCHO_CONTAINER:-moncho}"

usage() {
  cat <<'EOF'
Usage: moncho <command> [args...]

Runs a command inside the maintainer's dev container (the one ./start.sh builds).

  moncho npm test      run the suite in the container
  moncho sh            open a shell in the container
  moncho <anything>    any command the image has

Environment:
  MONCHO_CONTAINER     container name to exec into (default: moncho)
EOF
}

if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 0
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'Error: docker is not on PATH\n' >&2
  exit 1
fi

if ! docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  printf 'Error: no container named %s. Start one with: ./start.sh start\n' "$CONTAINER_NAME" >&2
  exit 1
fi

if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]; then
  printf 'Error: container %s is not running. Start it with: ./start.sh start\n' "$CONTAINER_NAME" >&2
  exit 1
fi

# -i keeps stdin open (a pipe works), -t only when there is a terminal to give it.
flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
  flags+=(-t)
fi

exec docker exec "${flags[@]}" -u "$(id -u)" "$CONTAINER_NAME" "$@"
