# Monchofile — Python project
#
# Two rules: the first instruction is FROM moncho-agent, and there is no ENTRYPOINT or
# CMD (moncho-cli appends the agent's own). Everything else is an ordinary Dockerfile.
FROM moncho-agent

# The interpreter and the build tooling the project needs.
RUN apk add --no-cache python3 py3-pip python3-dev build-base

WORKDIR /app

# Install into the image so a fresh container is ready to work. A virtualenv under
# the workspace would be shadowed by the bind mount, which is why this installs
# system-wide inside the image.
#
# The workspace is copied *before* the install, not a named dependency file. A COPY
# whose source does not exist fails the build, and no single filename is guaranteed
# here: detect_kind() sends a pyproject.toml or setup.py project to this starter too,
# and requirements.txt may be absent from either. `COPY . .` matches by construction.
COPY . .
RUN if [ -f requirements.txt ]; then \
      pip install --no-cache-dir --break-system-packages -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
      pip install --no-cache-dir --break-system-packages .; \
    fi

# Optional: a project-local virtualenv the agent should activate itself.
# RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt
